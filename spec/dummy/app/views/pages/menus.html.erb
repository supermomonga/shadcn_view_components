<style>
  [popover][role='menu'] { border: 1px solid #ccc; border-radius: 8px; background: #fff; padding: 4px; min-width: 180px; }
  [data-slot='dropdown-menu-item'], [data-slot='context-menu-item'] { padding: 6px 8px; border-radius: 4px; cursor: default; }
  [data-highlighted='true'] { background: #eee; outline: none; }
  [data-slot='resizable-handle'] { width: 8px; }
</style>
<main class="menu-page">
  <h1>Menus / Resizable</h1>

  <section id="dropdown-demo">
    <%= render(Shadcn::DropdownMenu.new) do %>
      <%= render(Shadcn::DropdownMenu::Trigger.new(id: "menu-trigger")) { "メニューを開く" } %>
      <%= render(Shadcn::DropdownMenu::Content.new(id: "menu-content")) do %>
        <%= render(Shadcn::DropdownMenu::Item.new(id: "item-copy")) { "コピー" } %>
        <%= render(Shadcn::DropdownMenu::Item.new(id: "item-paste")) { "貼り付け" } %>
        <%= render(Shadcn::DropdownMenu::Separator.new) %>
        <%= render(Shadcn::DropdownMenu::CheckboxItem.new(id: "item-check", checked: true)) { "通知を受け取る" } %>
      <% end %>
    <% end %>
  </section>

  <section id="context-demo">
    <%= render(Shadcn::ContextMenu.new) do %>
      <%= render(Shadcn::ContextMenu::Trigger.new(id: "context-area", class: "rounded-md border p-8", style: "display: inline-block")) do %>
        ここを右クリック
      <% end %>
      <%= render(Shadcn::ContextMenu::Content.new(id: "context-content")) do %>
        <%= render(Shadcn::ContextMenu::Item.new(id: "ctx-open")) { "開く" } %>
        <%= render(Shadcn::ContextMenu::Item.new(id: "ctx-rename")) { "名前を変更" } %>
      <% end %>
    <% end %>
  </section>

  <section id="resizable-demo">
    <%= render(Shadcn::Resizable::PanelGroup.new(id: "resize-group", style: "display: flex; height: 120px; width: 100%; border: 1px solid #ccc")) do %>
      <%= render(Shadcn::Resizable::Panel.new(id: "panel-left")) do %>
        <div style="padding: 8px">左</div>
      <% end %>
      <%= render(Shadcn::Resizable::Handle.new(id: "resize-handle")) %>
      <%= render(Shadcn::Resizable::Panel.new(id: "panel-right")) do %>
        <div style="padding: 8px">右</div>
      <% end %>
    <% end %>
  </section>
</main>
