<style>
  [popover][role='menu'] { border: 1px solid #ccc; border-radius: 8px; background: #fff; padding: 4px; min-width: 180px; }
  [data-slot='dropdown-menu-item'], [data-slot='context-menu-item'] { padding: 6px 8px; border-radius: 4px; cursor: default; }
  [data-highlighted='true'] { background: #eee; outline: none; }
  [data-slot='resizable-handle'] { width: 8px; }
  #floating-position-menu-fixtures[hidden] { display: none; }
</style>
<main class="menu-page">
  <h1>Menus / Resizable</h1>

  <section id="dropdown-demo">
    <%= render(Shadcn::DropdownMenu.new) do %>
      <%= render(Shadcn::DropdownMenu::Trigger.new(id: "menu-trigger")) { "メニューを開く" } %>
      <%= render(Shadcn::DropdownMenu::Content.new(id: "menu-content")) do %>
        <%= render(Shadcn::DropdownMenu::Item.new(id: "item-copy")) { "コピー" } %>
        <%= render(Shadcn::DropdownMenu::Item.new(id: "item-paste")) { "貼り付け" } %>
        <%= render(Shadcn::DropdownMenu::Separator.new) %>
        <%= render(Shadcn::DropdownMenu::CheckboxItem.new(id: "item-check", checked: true)) { "通知を受け取る" } %>
      <% end %>
    <% end %>
  </section>

  <section id="context-demo">
    <%= render(Shadcn::ContextMenu.new) do %>
      <%= render(Shadcn::ContextMenu::Trigger.new(id: "context-area", class: "rounded-md border p-8", style: "display: inline-block")) do %>
        ここを右クリック
      <% end %>
      <%= render(Shadcn::ContextMenu::Content.new(id: "context-content")) do %>
        <%= render(Shadcn::ContextMenu::Item.new(id: "ctx-open")) { "開く" } %>
        <%= render(Shadcn::ContextMenu::Item.new(id: "ctx-rename")) { "名前を変更" } %>
      <% end %>
    <% end %>
  </section>

  <section id="menubar-demo">
    <%= render(Shadcn::Menubar.new(id: "menubar")) do %>
      <%= render(Shadcn::Menubar::Menu.new) do %>
        <%= render(Shadcn::Menubar::Trigger.new(id: "menubar-file")) { "ファイル" } %>
        <%= render(Shadcn::Menubar::Content.new(id: "menubar-file-content")) do %>
          <%= render(Shadcn::Menubar::Item.new(id: "menubar-new")) { "新規作成" } %>
          <%= render(Shadcn::Menubar::Item.new(id: "menubar-save")) { "保存" } %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section id="nav-demo">
    <%= render(Shadcn::NavigationMenu.new(id: "nav")) do %>
      <%= render(Shadcn::NavigationMenu::List.new) do %>
        <%= render(Shadcn::NavigationMenu::Item.new) do %>
          <%= render(Shadcn::NavigationMenu::Link.new(id: "nav-home", href: "#")) { "ホーム" } %>
        <% end %>
        <%= render(Shadcn::NavigationMenu::Item.new) do %>
          <%= render(Shadcn::NavigationMenu::Trigger.new(id: "nav-docs")) { "ドキュメント" } %>
          <%= render(Shadcn::NavigationMenu::Content.new(id: "nav-docs-content")) do %>
            <%= render(Shadcn::NavigationMenu::Link.new(id: "nav-intro", href: "#intro")) { "はじめに" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section id="resizable-demo">
    <%= render(Shadcn::Resizable::PanelGroup.new(id: "resize-group", style: "display: flex; height: 120px; width: 100%; border: 1px solid #ccc")) do %>
      <%= render(Shadcn::Resizable::Panel.new(id: "panel-left")) do %>
        <div style="padding: 8px">左</div>
      <% end %>
      <%= render(Shadcn::Resizable::Handle.new(id: "resize-handle")) %>
      <%= render(Shadcn::Resizable::Panel.new(id: "panel-right")) do %>
        <div style="padding: 8px">右</div>
      <% end %>
    <% end %>
  </section>

  <%# 実Chromeでだけ有効化する位置決めfixture。hidden中は既存system specのlayoutを変えない。 %>
  <section id="floating-position-menu-fixtures" hidden>
    <%= render(Shadcn::ContextMenu.new(id: "fp-context-root")) do %>
      <%= render(Shadcn::ContextMenu::Trigger.new(
        id: "fp-context-trigger",
        style: "position: fixed; right: 10px; bottom: 10px; width: 120px; height: 60px; box-sizing: border-box"
      )) { "context point" } %>
      <%= render(Shadcn::ContextMenu::Content.new(
        id: "fp-context-content",
        style: "width: 160px; height: 96px; box-sizing: border-box"
      )) do %>
        <%= render(Shadcn::ContextMenu::Item.new(id: "fp-context-item")) { "item" } %>
      <% end %>
    <% end %>

    <%= render(Shadcn::DropdownMenu.new(id: "fp-submenu-root")) do %>
      <%= render(Shadcn::DropdownMenu::Trigger.new(
        id: "fp-submenu-main-trigger",
        style: "position: fixed; top: 180px; left: 300px; width: 100px; height: 28px; box-sizing: border-box"
      )) { "submenu" } %>
      <%= render(Shadcn::DropdownMenu::Content.new(
        id: "fp-submenu-main-content",
        style: "width: 200px; box-sizing: border-box"
      )) do %>
        <%= render(Shadcn::DropdownMenu::Sub.new(id: "fp-submenu-scope")) do %>
          <%= render(Shadcn::DropdownMenu::SubTrigger.new(
            id: "fp-submenu-trigger",
            style: "display: block; width: 160px; height: 32px; box-sizing: border-box"
          )) { "nested" } %>
          <%= render(Shadcn::DropdownMenu::SubContent.new(
            id: "fp-submenu-content",
            style: "width: 140px; height: 70px; box-sizing: border-box"
          )) do %>
            <%= render(Shadcn::DropdownMenu::Item.new(id: "fp-submenu-item")) { "nested item" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</main>
